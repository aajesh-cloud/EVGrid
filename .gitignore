# ---------------------------------------------------------------------------
# EVGrid — files that must never reach GitHub
# ---------------------------------------------------------------------------
# `backend/.env` holds the MySQL password and the Gmail App Password, and the
# project-root `.env` holds the Vite build-time variables. Neither is committed;
# `*.env.example` templates are.

# --- Secrets / environment -------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Build output ----------------------------------------------------------
dist/
dist-ssr/
build/
.vite/
.vite-cache/
*.tsbuildinfo

# --- Local database files & dumps ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
dumps/
mysql-data/

# --- Logs ------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Tests / coverage ------------------------------------------------------
coverage/
.nyc_output/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Misc ------------------------------------------------------------------
.cache/
tmp/
temp/
