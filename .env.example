# ---------------------------------------------------------------------------
# EVGrid frontend — environment template (project root)
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development:
#     copy .env.example .env        (Windows PowerShell)
#     cp .env.example .env          (macOS / Linux)
#
# Only variables prefixed with `VITE_` are exposed to the browser. They are
# inlined at BUILD time, so on Vercel they must be set in
# Project → Settings → Environment Variables *before* the build runs.
#
# Never put a database password, JWT secret or SMTP password in this file —
# those belong in backend/.env, which is server-side only.
# ---------------------------------------------------------------------------

# Base URL of the EVGrid API, including the /api prefix.
#   Local development     http://localhost:5000/api
#   Vercel + Render       https://<your-api>.onrender.com/api
#   Behind the dev proxy  /api
VITE_API_BASE_URL=http://localhost:5000/api

# Only used by the Vite dev server, when VITE_API_BASE_URL=/api.
# Ignored in production builds.
VITE_API_PROXY_TARGET=http://localhost:5000
