# ---------------------------------------------------------------------------
# EVGrid backend — environment template
# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in real values:
#     cp backend/.env.example backend/.env      (macOS / Linux)
#     copy backend\.env.example backend\.env    (Windows PowerShell)
#
# `backend/.env` holds database credentials and MUST NOT be committed or
# exposed to the frontend. Only the Vite variables in the project-root `.env`
# are visible to the browser.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | production
NODE_ENV=development
# Port the API listens on. The frontend expects 5000.
PORT=5000
# Path prefix for every API route (base URL is http://localhost:5000/api).
API_PREFIX=/api
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- MySQL -----------------------------------------------------------------
# Host, port and credentials of your MySQL 8 server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Database created by `npm run db:setup`.
DB_NAME=evgrid
# Connection pool + query limits.
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT=10000
DB_DEFAULT_LIMIT=250
DB_MAX_LIMIT=1000
# TLS — required by most hosted MySQL providers (Aiven, Clever Cloud, Railway,
# TiDB Cloud, PlanetScale …). Leave both empty for a local MySQL server.
#   DB_SSL=require   encrypt the connection, do not verify the certificate
#   DB_SSL=verify    encrypt and verify it (uses DB_SSL_CA below)
#   unset / disable  plain, unencrypted connection
DB_SSL=
# Only used with DB_SSL=verify: the provider's CA certificate, given either as
# PEM text (literal newlines written as \n) or as a path to a .pem file.
DB_SSL_CA=

# --- Authentication --------------------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Lifetime of an issued access token.
JWT_EXPIRES_IN=12h
# bcrypt cost factor for passwords and one-time codes.
BCRYPT_ROUNDS=10
# Email verification code: number of digits and validity window.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# Resend limits for verification codes (per email address):
# wait this long between two requests, and allow at most N sends per window.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_WINDOW_MINUTES=15
OTP_MAX_SENDS_PER_WINDOW=5
# Password-reset link validity.
RESET_TOKEN_TTL_MINUTES=60

# --- Email delivery (Gmail SMTP) -------------------------------------------
# Verification codes are emailed through Gmail using a Google *App Password*.
# A normal account password will NOT work.
#
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are fine, they are stripped).
#
# Leave SMTP_USER / SMTP_PASSWORD empty and, in development, the code is
# printed to the API console instead. In production a missing value makes
# registration fail with 503 — email delivery is not optional there.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (recommended), 587 = STARTTLS.
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail address that sends the mail, e.g. noreply.evgrid@gmail.com
SMTP_USER=
# The 16-character Google app password for that address.
SMTP_PASSWORD=
# Displayed sender name and optional From override (defaults to SMTP_USER).
MAIL_FROM_NAME=EVGrid
MAIL_FROM=
# Connection timeouts in milliseconds (fail fast instead of hanging).
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=20000
